{
  "name": "koyosim",
  "description": "KoyoSIM AI Studio - Next-Gen Generative AI Creative Platform",
  "homepage": "https://www.koyosim.com",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "workspaces": [
    "packages/studio",
    "packages/Vibe-Workflow/packages/workflow-builder",
    "packages/Open-Poe-AI/packages/agents",
    "packages/Open-AI-Design-Agent/packages/design-agent"
  ],
  "scripts": {
    "dev": "node scripts/require-database-url.mjs && next dev",
    "build": "next build",
    "start": "node scripts/require-database-url.mjs && next start",
    "lint": "next lint",
    "format:check": "node scripts/check-format.mjs",
    "release:check": "node scripts/release-safety-check.mjs",
    "security:secrets": "node scripts/secret-scan.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:test": "node scripts/migrate-test.mjs",
    "db:status": "node scripts/db-status.mjs",
    "test:db": "node scripts/run-isolated-pg-tests.mjs",
    "migration:drill": "node scripts/migration-drill.mjs",
    "backup:restore:drill": "node scripts/backup-restore-drill.mjs",
    "test:p0": "node --experimental-loader ./scripts/server-only-loader.mjs --test tests/p0/*.test.mjs",
    "test:p2": "node --experimental-loader ./scripts/server-only-loader.mjs --test tests/p2/*.test.mjs",
    "test:p3": "node --experimental-loader ./scripts/server-only-loader.mjs --test tests/p3/*.test.mjs",
    "test:p4": "node --experimental-loader ./scripts/server-only-loader.mjs --test tests/p4/*.test.mjs",
    "test:p5": "node --experimental-loader ./scripts/server-only-loader.mjs --test tests/p5/*.test.mjs",
    "test:p6": "node --experimental-loader ./scripts/server-only-loader.mjs --test tests/p6/*.test.mjs",
    "test:p7": "node --experimental-loader ./scripts/server-only-loader.mjs --test tests/p7/*.test.mjs",
    "test:admin": "node --experimental-loader ./scripts/server-only-loader.mjs --test tests/admin/*.test.mjs",
    "test:i18n": "node scripts/test-i18n.mjs && node scripts/validate-i18n.mjs --strict",
    "test:content": "node --experimental-loader ./scripts/server-only-loader.mjs scripts/test-content-management.mjs",
    "e2e:seed": "node scripts/e2e-seed.mjs",
    "e2e:clean": "node scripts/e2e-clean.mjs",
    "test:e2e": "playwright test",
    "test:ci": "npm run format:check && npm run lint && npm run release:check && npm run security:secrets && npm run test:i18n && npm run test:p0 && npm run test:p2 && npm run test:p3 && npm run test:p4 && npm run test:p5 && npm run test:p6 && npm run test:p7 && npm run test:admin && npm run build:studio && npm run vite:build && npm run build",
    "worker:generation": "node scripts/require-database-url.mjs && node scripts/generation-worker.mjs",
    "worker:generation:supervised": "node scripts/require-database-url.mjs && node scripts/generation-worker-supervisor.mjs",
    "backup:db": "node scripts/auto-backup-s3.mjs",
    "verify:admin": "node scripts/verify-phase1.mjs && node scripts/verify-phase2.mjs && node scripts/verify-phase3.mjs && node scripts/verify-phase4.mjs",
    "build:studio": "npm run build -w studio",
    "build:workflow": "npm run build -w workflow-builder",
    "build:agent": "npm run build -w ai-agent",
    "build:design": "npm run build -w design-agent",
    "build:packages": "npm run build:workflow && npm run build:agent && npm run build:design && npm run build:studio",
    "setup": "git submodule update --init --recursive && npm install && npm run build:packages",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "electron:dev": "npm run vite:build && electron .",
    "electron:build": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:linux": "vite build && electron-builder --linux",
    "electron:build:linux:dir": "vite build && electron-builder --linux dir",
    "electron:build:linux:arm64:dir": "vite build && electron-builder --linux dir --arm64",
    "stage:local-ai": "node scripts/stage-local-ai-binary.js",
    "package:linux:deb": "node scripts/package-linux-deb.js",
    "package:linux:deb:arm64": "node scripts/package-linux-deb.js --arch arm64",
    "package:linux:deb:x64": "node scripts/package-linux-deb.js --arch x64",
    "electron:build:all": "vite build && electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "ai.generative.open",
    "productName": "koyosim",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "release"
    },
    "afterPack": "./afterPack.js",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/local-ai",
        "to": "local-ai",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "public/banner.png",
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/banner.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "icon": "public/banner.png",
      "category": "Utility",
      "maintainer": "koyosim Team",
      "extraFiles": [
        {
          "from": "build/linux/apparmor.profile",
          "to": "resources/apparmor.profile"
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "ai-agent": "file:./packages/Open-Poe-AI/packages/agents",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "^15.5.24",
    "next-intl": "^4.14.5",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "stripe": "^22.6.2",
    "studio": "*",
    "tw-animate-css": "^1.4.0",
    "workflow-builder": "file:./packages/Vibe-Workflow/packages/workflow-builder",
    "xtend": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.18",
    "autoprefixer": "^10.4.24",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.0",
    "vite": "^8.3.0"
  },
  "main": "electron/main.js"
}
