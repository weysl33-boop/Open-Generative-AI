# PostgreSQL 16 is required for all runtime and migration operations.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/open_generative_ai
# Tests must use a separate database, never a production DATABASE_URL.
TEST_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/open_generative_ai_test
BILLING_SESSION_TTL_DAYS=30
BILLING_SESSION_SECRET=replace-with-a-long-random-secret
PROVIDER_SECRETS_ENCRYPTION_KEY=replace-with-a-dedicated-long-random-secret
OAUTH_STATE_SECRET=replace-with-another-long-random-secret
ADMIN_BOOTSTRAP_TOKEN_HASH=
GENERATION_CALLBACK_SECRET=replace-with-a-long-random-provider-callback-secret
GENERATION_PROVIDER_MODE=http
MOCK_PROVIDER_OUTCOME=succeeded
ALLOW_MOCK_GENERATION=false
E2E_TEST_MODE=false
GENERATION_ASYNC=true
AUTH_VERIFICATION_CODE_SECRET=replace-with-a-long-random-verification-secret
CSRF_ORIGIN_REQUIRED=true
SMS_CHINA_PRIMARY=tencent_sms
SMS_CHINA_FALLBACK=aliyun_sms
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# Firebase web config only. The API key is public project configuration, not a server credential.
# It is read server-side and returned only to the browser for international phone verification.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Tencent CAPTCHA is loaded only for elevated-risk +86 Web requests.
TENCENT_CAPTCHA_APP_ID=
TENCENT_CAPTCHA_SECRET_ID=
TENCENT_CAPTCHA_SECRET_KEY=
TENCENT_CAPTCHA_APP_SECRET_KEY=
# QQ 企业邮箱 SMTP（生产建议在后台使用加密写入方式保存 SMTP 客户端密码）
EMAIL_SMTP_USER=
EMAIL_SMTP_FROM_NAME=KoyoSIM
EMAIL_SMTP_PASSWORD=
# 新用户注册/第三方登录赠送体验额度（默认 10 额度，可根据需要调整）
INITIAL_SIGNUP_CREDITS=10
# Set PUBLIC_APP_URL to the exact public origin used by the OAuth consoles.
PUBLIC_APP_URL=https://your-domain.example

# P6 payment/provider controls. Keep test and live credentials separate.
# A channel is only offered on /api/billing/plans and accepted at checkout when
# it can both charge and verify the provider's callback signature. The public
# response only says which channels are enabled; the missing pieces are reported
# to the admin provider list (providers.*.missingCredentials) instead.
# Channel status is cached in-process for this many milliseconds (0 disables the
# cache) so an unauthenticated /api/billing/plans load cannot hammer the secret
# store; a store that fails to read is never cached and is retried immediately.
PAYMENT_CHANNEL_CACHE_TTL_MS=30000
# Every credential below may instead be stored server-side (encrypted provider
# secret store); the environment always wins over the stored value.
STRIPE_MODE=test
STRIPE_LIVE_ENABLED=false
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WeChat Pay V3. The merchant public key (platform certificate) is required even
# though it is only used on callbacks: without it every notification is
# rejected, so orders would stay unpaid after the money has been collected.
WECHAT_ENABLED=true
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
# Legacy alias, only read when WECHAT_CERT_SERIAL_NO is empty.
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PUBLIC_KEY=
WECHAT_CERT_PATH=
# Optional override; defaults to ${PUBLIC_APP_URL}/api/billing/webhooks/wechat
WECHAT_NOTIFY_URL=

# Alipay (RSA2). ALIPAY_PUBLIC_KEY is the platform key used to verify callbacks.
ALIPAY_ENABLED=true
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# Optional override; defaults to ${PUBLIC_APP_URL}/api/billing/webhooks/alipay
ALIPAY_NOTIFY_URL=

# Payment reconciliation, driven by the resident generation worker heartbeat.
# Failed/undecidable webhooks are replayed with exponential backoff; pending
# native orders are polled in case a notification never arrived.
WEBHOOK_RETRY_INTERVAL_MS=30000
WEBHOOK_RETRY_STALE_MS=600000
WEBHOOK_RETRY_MAX_ATTEMPTS=12
PAYMENT_RECONCILE_INTERVAL_MS=300000
PAYMENT_RECONCILE_GRACE_MS=180000
PAYMENT_RECONCILE_MAX_AGE_MS=86400000

# Generation worker (scripts/generation-worker-supervisor.mjs).
GENERATION_WORKER_POLL_MS=1000
GENERATION_WORKER_BATCH_SIZE=10
GENERATION_WORKER_MAX_RESTARTS=5
GENERATION_WORKER_RESTART_WINDOW_MS=600000
GENERATION_WORKER_RESTART_BACKOFF_MS=1000

PROVIDER_TIMEOUT_MS=60000
PROVIDER_MAX_RETRIES=2
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_RESET_MS=30000

# 取价口径：parity 沿用 legacy models_config.credits_price（与线上现价一致，默认）；
# catalog 改按标准目录 model_pricing 计算（积分刻度是千级，切换前必须先由运营定目标价）。
GENERATION_QUOTE_SOURCE=parity

# Google OAuth: callback /api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X (Twitter) OAuth 2.0: callback /api/auth/oauth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# TikTok Login Kit: callback /api/auth/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Mainland social login (website-app credentials; preferably configure via
# Admin -> Integrations -> Social Login so they are encrypted in provider_secrets).
# WeChat uses its own wechat_oauth credential namespace, separate from WeChat Pay.
WECHAT_OAUTH_APP_ID=
WECHAT_OAUTH_APP_SECRET=
QQ_APP_ID=
QQ_APP_KEY=
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=

# Mainland-China IP gate (middleware layer, off by default until the
# china_ip_block setting is saved in the admin UI).
# Break-glass: set to true and restart to force the gate off even when the
# stored config says on — use it if the block ever locks out your own admin.
CHINA_IP_GATE_DISABLED=false
# Optional: allows the `x-test-ip` simulation header in production (for smoke
# tests from a foreign egress). Without it the header is ignored outside dev.
CHINA_IP_GATE_TEST_TOKEN=

# Production SMS sends always use configured providers; no mock code is returned
# by the public authentication APIs. Cookie-authenticated mutations require a
# same-origin request in production.
